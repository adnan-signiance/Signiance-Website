    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.12.0",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.0.0",
    "sharp": "0.35.5",
    "typescript": "^5.5.4",
