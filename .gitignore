node_modules
.next
out
next-env.d.ts
npm-debug.log*
.DS_Store
*.local

# Environment files. `.env.example` is intentionally tracked; real env files
# must never be committed.
.env
.env.*
!.env.example

# Test and coverage output
coverage
test-results
playwright-report

# Sanity Studio build output (its node_modules is already covered above)
studio/dist
studio/.sanity

# Local Lighthouse CI run output
.lighthouseci

# TypeScript incremental build cache
*.tsbuildinfo

.claude/scheduled_tasks.lock

# Output of studio/scripts/import-wordpress.mjs (regenerable; the redirects live in redirects/)
studio/wordpress-posts.ndjson
studio/wordpress-redirects.json

# Design source files (clip-art sets, photo originals, retired images). Kept on disk, out of the deployed repo;
# nothing under public/ is deployed unless the site refers to it.
design-source/

# Local tooling that is not part of the site: design-skill output (screenshots, drafts), the project-local
# copy of the skill, and agent task notes. The skill under .agents/skills is tracked; these are not.
.taste-skill/
.claude/skills/
.agents/tasks/
