# Copy to `.env.local` and adjust.
#
# Every value here is NEXT_PUBLIC_*: inlined into the browser bundle, so public.
# Never put a secret in this file.

# Cal.com booking target, "<account>/<event-slug>".
# Should be a company account, not a personal handle.
NEXT_PUBLIC_CAL_LINK=adnan2004/15min

# Length of the event above, in minutes. The site quotes this number in copy
# ("N minutes with the people who'd do the work"), so it must match the real
# Cal.com event or the page promises something the booking form won't honour.
NEXT_PUBLIC_CAL_MINUTES=15

# Canonical origin, used for metadataBase, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.signiance.com

# Plausible site domain, e.g. "signiance.com". Analytics is cookieless, so it
# does not sit behind the cookie consent gate. Leave empty to disable entirely —
# no script is loaded and every track() call becomes a no-op.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Enquiry form + newsletter delivery: the Google Apps Script web app URL that
# emails hello@signiance.com. Setup steps in integrations/google-apps-script/.
# There is no server of our own, so this is the only setting delivery needs.
# Inlined at build time, so rebuild after changing it.
#
# Without it the forms say they could not send and show the email address
# instead. Nothing is silently dropped, but no enquiry is delivered either, so
# set this before launch.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://script.google.com/macros/s/AKfycbwWQK_pDn8TBVFkSAruyLepEhabvbj_b7yQKqwn0MJHXRwDwf6HbyqCJtVdJcii7DRmOw/exec

# ---------------------------------------------------------------------------
# CMS (Sanity): case studies and the blog. Server-side, read at build time.
# Setup is in studio/README.md. A project ID is public, but these are build
# settings, so set them on the host as well as here.
#
# Leave SANITY_PROJECT_ID empty to build from the case studies bundled in
# lib/data.ts, with no blog posts. That is what CI and a fresh checkout do.
# ---------------------------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only if the dataset is private. A public dataset serves published content with
# no token, which is the simpler setup. This one IS a secret: never prefix it
# with NEXT_PUBLIC_.
SANITY_READ_TOKEN=
